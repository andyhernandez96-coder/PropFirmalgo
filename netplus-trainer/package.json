{
  "name": "netplus-trainer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local CompTIA Network+ (N10-009) practice app",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx server/index.ts\" \"vite\"",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "questions:build": "tsx content/build.ts"
  },
  "dependencies": {
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "autoprefixer": "10.6.1",
    "concurrently": "9.2.4",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
